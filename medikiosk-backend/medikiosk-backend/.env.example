# Copy to .env and adjust. Every value has a working default, so this file
# is optional for local dev — it matters once you move to Postgres / prod.

ENV=development
DEBUG=true

# Local dev default. For Postgres:
#   DATABASE_URL=postgresql://medikiosk:medikiosk@localhost:5432/medikiosk
DATABASE_URL=sqlite:///./medikiosk.db

JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Flip these to false only once you have real credentials wired into
# app/services/abha_mock.py and app/services/bhashini_mock.py.
MOCK_ABHA=true
MOCK_BHASHINI=true
MOCK_TELEMEDICINE=true
